PORT=5000
# Production: use MongoDB Atlas connection string
# e.g. mongodb+srv://user:pass@cluster.mongodb.net/linkup
MONGODB_URI=mongodb://localhost:27017/linkup
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
# In production set to your deployed frontend URL
CLIENT_URL=http://localhost:3000

# Public-facing server URL (used in admin email links)
APP_URL=https://your-app-domain.com

# Admin review email (rating approval/rejection links are sent here)
ADMIN_EMAIL=kelly@linkupathlethics.com
# Secret used to sign one-click admin approve/reject tokens
# Also used as the password for the admin dashboard:
#   https://your-app-domain.com/api/admin/dashboard?token=<ADMIN_SECRET>
ADMIN_SECRET=change_this_to_a_long_random_string

# Cloudinary — required for avatar and document uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP — e.g. Gmail, SendGrid, Mailgun, AWS SES, or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
