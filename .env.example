PORT=5000
MONGODB_URI=mongodb://localhost:27017/linkup
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Public-facing server URL (used in admin email links)
APP_URL=https://your-app-domain.com

# Admin review email (rating approval/rejection links are sent here)
ADMIN_EMAIL=kelly@linkupathlethics.com
# Secret used to sign one-click admin approve/reject tokens
# Also used as the password for the admin dashboard:
#   https://your-app-domain.com/api/admin/dashboard?token=<ADMIN_SECRET>
ADMIN_SECRET=change_this_to_a_long_random_string

# SMTP — e.g. Gmail, SendGrid, Mailgun, AWS SES, or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
