{
  "name": "linkup-backend",
  "version": "1.0.0",
  "description": "Backend API for LinkUp social networking app",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "MONGOMS_SYSTEM_BINARY=/opt/miniconda3/bin/mongod jest",
    "test:watch": "MONGOMS_SYSTEM_BINARY=/opt/miniconda3/bin/mongod jest --watch",
    "seed": "node scripts/seed.js",
    "db:start": "bash scripts/start-mongo.sh",
    "db:seed": "bash scripts/start-mongo.sh && node scripts/seed.js"
  },
  "dependencies": {
    "@sentry/node": "^10.52.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.5.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-apn": "^3.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "resend": "^6.12.4",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "mongodbMemoryServer": {
    "systemBinary": "/opt/miniconda3/bin/mongod",
    "version": "6.0.16"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  }
}
