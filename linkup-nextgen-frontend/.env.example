# Backend API URL
# Development: leave unset (defaults to http://localhost:5000)
# Production: set to your deployed backend, e.g. https://api.linkupathletics.com
VITE_API_URL=http://localhost:5000

# Sentry — optional, leave unset in development to disable
# Get your DSN from https://sentry.io → New Project → React
VITE_SENTRY_DSN=
